    "def pass_rate(score_list):\n",
    "    \"\"\"Return the percentage of scores that are >= 50.\"\"\"\n",
    "    passed = 0\n",
    "    total = 0\n",
    "    for s in score_list:\n",
    "        total += 1\n",
    "        if s >= 50:\n",
    "            passed += 1\n",
    "    if total == 0:\n",
    "        return 0.0\n",
    "    return passed / total * 100\n",
    "\n",
    "scores = [72, 85, 91, 64, 78, 47, 88, 55, 93, 61]\n",
    "print(pass_rate(scores))"
   ]
