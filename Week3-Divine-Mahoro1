    "def get_grade(score):\n",
    "    \"\"\"Return the letter grade (A-F) for a numeric score.\"\"\"\n",
    "    if score >= 85:\n",
    "        return \"A\"\n",
    "    elif score >= 70:\n",
    "        return \"B\"\n",
    "    elif score >= 60:\n",
    "        return \"C\"\n",
    "    elif score >= 50:\n",
    "        return \"D\"\n",
    "    else:\n",
    "        return \"F\"\n",
    "\n",
    "for s in [91, 76, 43]:\n",
    "    print(s, \"->\", get_grade(s))"
