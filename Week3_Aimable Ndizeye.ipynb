    "## Exercises 5.3\n",
    "\n",
    "sums = {}\n",
    "counts = {}\n",
    "\n",
    "for line in lines[1:]:\n",
    "    parts = line.strip().split(\",\")\n",
    "\n",
    "    d = parts[5]\n",
    "    score_text = parts[7]\n",
    "\n",
    "    # Skip invalid scores\n",
    "    if not score_text.isdigit():\n",
    "        continue\n",
    "\n",
    "    s = int(score_text)\n",
    "\n",
    "    # Accumulate district scores and counts\n",
    "    sums[d] = sums.get(d, 0) + s\n",
    "    counts[d] = counts.get(d, 0) + 1\n",
    "\n",
    "# Calculate and print every district's average\n",
    "for d in sums:\n",
    "    average = sums[d] / counts[d]\n",
    "    print(f\"{d}: {average:.2f}\")"
   ]
